# Copy to .env and fill in. .env is gitignored: never commit keys.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a TTS model id. Leave empty to auto-discover one (python -m pipeline.smoke lists them).
GEMINI_TTS_MODEL=
# API version for Gemini calls (TTS needs v1beta)
GEMINI_API_VERSION=v1beta

# Cloudflare Workers AI (keyframes): dashboard -> Account ID; My Profile -> API Tokens -> "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Kaggle (GPU for Wan 2.2 / ACE-Step). kaggle.com -> Settings -> API -> Generate New Token (starts with KGAT_)
KAGGLE_API_TOKEN=
# Legacy alternative: username + key from an old kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=
